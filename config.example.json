{
  "llm": {
    "provider": "openai",
    "config": {
      "model": "deepseek-flash",
      "api_key": "sk-REPLACE_ME",
      "openai_base_url": "https://api.deepseek.com/v1"
    }
  },
  "embedder": {
    "provider": "openai",
    "config": {
      "model": "BAAI/bge-m3",
      "api_key": "sk-REPLACE_ME",
      "openai_base_url": "https://api.siliconflow.cn/v1"
    }
  },
  "vector_store": {
    "provider": "chroma",
    "config": {
      "collection_name": "dsh_memory",
      "path": "~/.dsh-mem0/store"
    }
  },
  "custom_fact_extraction_prompt": "你是一个记忆抽取器。请从下面的对话中抽取值得长期记住的事实，用简体中文、单句陈述。\n只抽取关于用户本人的：身份、偏好、习惯、目标、项目、约束、决定、踩过的坑。\n不要抽取寒暄、过程性对话、模型自己的推断。\n每条事实必须能独立成立（不要用「他/她/这个」指代）。\n输出 JSON，格式：{\"facts\": [\"事实1\", \"事实2\"]}。没有可抽的返回 {\"facts\": []}。",
  "version": "v1.1"
}
